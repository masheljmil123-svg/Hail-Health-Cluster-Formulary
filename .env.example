# Copy to .env.local for shared multi-user backend (never commit secrets).
# .env.local is gitignored (via .env.* and *.local).

# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer the publishable/anon key from the Supabase dashboard:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy alias also accepted:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional email bridge (server holds EMAIL_API_KEY — see docs/BACKEND.md)
# VITE_EMAIL_ENABLED=true
# VITE_EMAIL_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/send-workflow-email
