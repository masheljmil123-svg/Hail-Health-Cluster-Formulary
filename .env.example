# Enable Login + local admin/team/staff evaluation UI in a production build.
# GitHub Actions sets this to true for the evaluation Pages deploy.
# Test accounts are public frontend constants — not real security.
# VITE_ENABLE_LOCAL_ADMIN=true

# Public asset / router base path for GitHub Pages project sites.
# GitHub Actions sets this automatically for masheljmil123-svg/Hail-Health-Cluster-Formulary.
# VITE_BASE_PATH=/Hail-Health-Cluster-Formulary/
